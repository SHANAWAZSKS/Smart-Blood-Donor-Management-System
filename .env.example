# ─── Vercel Deployment URLs ───────────────────────────────────────────────────
# Set this on the FRONTEND Vercel project so it knows where the backend lives.
VITE_API_URL=https://smart-blood-donor-management-system-chi.vercel.app

# ─── Database ────────────────────────────────────────────────────────────────
# MySQL connection URL used by Drizzle ORM and the Express server.
DATABASE_URL=mysql://user:password@localhost:3306/lifelink

# ─── Authentication / JWT ────────────────────────────────────────────────────
# Secret key for signing session JWTs. Must be at least 32 characters.
JWT_SECRET=replace-with-a-random-32-char-secret

# ─── OAuth (Manus / external provider) ───────────────────────────────────────
# Leave blank to use local email-based auth (no OAuth portal needed).
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# ─── Owner account ───────────────────────────────────────────────────────────
# The openId of the first user who should automatically receive the admin role.
OWNER_OPEN_ID=

# ─── Google Maps (Live Donor Map feature) ────────────────────────────────────
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# ─── AWS S3 (optional file uploads) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ─── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
